  \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n</ul>\n\n\n\n        \n\n        \n                    \n                \n\n\n\n    \n            <!-- <p class=\"article-top-author\">Эльяс Касми</p> -->\n    \n            <p>12 Октября 2026 11:32\n            12 Окт 2026 11:32\n            \t\t\t\t\t\n\t\t\t                \n            \n                        \n            |</p>\n        \n    \n    \n    \n        \n    \n\n            \n    \n    \n\n    \n    \n\t\n\t        \n        \n            \n            <p><a href=\"https://www.cnews.ru/book/WDM_-_Wavelength_Division_Multiplexing_-_DWDM_-_Dense_Wavelength_Division_Multiplexing_-_CWDM_-_Coarse_Wavelength_Division_Multiplexing_-_TWDM_-_Time_and_Wavelength_Division_Multiplexed_-_%D0%9F%D0%BB%D0%BE%D1%82%D0%BD%D0%BE%D0%B5_%D0%BC%D1%83%D0%BB%D1%8C%D1%82%D0%B8%D0%BF%D0%BB%D0%B5%D0%BA%D1%81%D0%B8%D1%80%D0%BE%D0%B2%D0%B0%D0%BD%D0%B8%D0%B5_%D1%81_%D1%80%D0%B0%D0%B7%D0%B4%D0%B5%D0%BB%D0%B5%D0%BD%D0%B8%D0%B5%D0%BC_%D0%BF%D0%BE_%D0%B4%D0%BB%D0%B8%D0%BD%D0%B5_%D0%B2%D0%BE%D0%BB%D0%BD%D1%8B\">DWDM</a>-ситема «Булат» включена в <a href=\"https://www.cnews.ru/book/%D0%9C%D0%B8%D0%BD%D0%BF%D1%80%D0%BE%D0%BC%D1%82%D0%BE%D1%80%D0%B3_%D0%A0%D0%A4_-_%D0%93%D0%98%D0%A1%D0%9F_%D0%A0%D0%A4_-_%D0%93%D0%BE%D1%81%D1%83%D0%B4%D0%B0%D1%80%D1%81%D1%82%D0%B2%D0%B5%D0%BD%D0%BD%D0%B0%D1%8F_%D0%B8%D0%BD%D1%84%D0%BE%D1%80%D0%BC%D0%B0%D1%86%D0%B8%D0%BE%D0%BD%D0%BD%D0%B0%D1%8F_%D1%81%D0%B8%D1%81%D1%82%D0%B5%D0%BC%D0%B0_%D0%BF%D1%80%D0%BE%D0%BC%D1%8B%D1%88%D0%BB%D0%B5%D0%BD%D0%BD%D0%BE%D1%81%D1%82%D0%B8_-_%D0%A0%D0%A0%D0%9F%D0%9F_-_%D0%A0%D0%B5%D0%B5%D1%81%D1%82%D1%80_%D1%80%D0%BE%D1%81%D1%81%D0%B8%D0%B9%D1%81%D0%BA%D0%BE%D0%B9_%D0%BF%D1%80%D0%BE%D0%BC%D1%8B%D1%88%D0%BB%D0%B5%D0%BD%D0%BD%D0%BE%D0%B9_%D0%BF%D1%80%D0%BE%D0%B4%D1%83%D0%BA%D1%86%D0%B8%D0%B8_-_%D0%93%D0%98%D0%A1%D0%98%D0%9F_-_%D0%93%D0%B5%D0%BE%D0%B8%D0%BD%D1%84%D0%BE%D1%80%D0%BC%D0%B0%D1%86%D0%B8%D0%BE%D0%BD%D0%BD%D0%BE%D0%B9_%D1%81%D0%B8%D1%81%D1%82%D0%B5%D0%BC%D1%8B_%D0%B8%D0%BD%D0%B4%D1%83%D1%81%D1%82%D1%80%D0%B8%D0%B0%D0%BB%D1%8C%D0%BD%D1%8B%D1%85_%D0%BF%D0%B0%D1%80%D0%BA%D0%BE%D0%B2_%D1%82%D0%B5%D1%85%D0%BD%D0%BE%D0%BF%D0%B0%D1%80%D0%BA%D0%BE%D0%B2_%D0%B8_%D0%BF%D1%80%D0%BE%D0%BC%D1%8B%D1%88%D0%BB%D0%B5%D0%BD%D0%BD%D1%8B%D1%85_%D0%BA%D0%BB%D0%B0%D1%81%D1%82%D0%B5%D1%80%D0%BE%D0%B2_%D0%A0%D0%BE%D1%81%D1%81%D0%B8%D0%B8\">реестр российской промышленной продукции</a> <a href=\"https://www.cnews.ru/book/%D0%9C%D0%B8%D0%BD%D0%BF%D1%80%D0%BE%D0%BC%D1%82%D0%BE%D1%80%D0%B3_%D0%A0%D0%A4_-_%D0%9C%D0%B8%D0%BD%D0%B8%D1%81%D1%82%D0%B5%D1%80%D1%81%D1%82%D0%B2%D0%BE_%D0%BF%D1%80%D0%BE%D0%BC%D1%8B%D1%88%D0%BB%D0%B5%D0%BD%D0%BD%D0%BE%D1%81%D1%82%D0%B8_%D0%B8_%D1%82%D0%BE%D1%80%D0%B3%D0%BE%D0%B2%D0%BB%D0%B8_%D0%A0%D0%BE%D1%81%D1%81%D0%B8%D0%B9%D1%81%D0%BA%D0%BE%D0%B9_%D0%A4%D0%B5%D0%B4%D0%B5%D1%80%D0%B0%D1%86%D0%B8%D0%B8\">Минпромторга России</a> по коду «Оборудование цифровых волоконно-<a href=\"https://www.cnews.ru/book/%D0%9E%D0%BF%D1%82%D0%B8%D1%87%D0%B5%D1%81%D0%BA%D0%B8%D0%B5_%D1%82%D0%B5%D1%85%D0%BD%D0%BE%D0%BB%D0%BE%D0%B3%D0%B8%D0%B8_-_Optical_technologies_-_%D0%B2%D1%8B%D1%81%D0%BE%D0%BA%D0%BE%D1%82%D0%B5%D1%85%D0%BD%D0%BE%D0%BB%D0%BE%D0%B3%D0%B8%D1%87%D0%BD%D0%B0%D1%8F_%D0%BE%D0%BF%D1%82%D0%B8%D0%BA%D0%BE-%D1%8D%D0%BB%D0%B5%D0%BA%D1%82%D1%80%D0%BE%D0%BD%D0%BD%D0%B0%D1%8F_%D1%82%D0%B5%D1%85%D0%BD%D0%B8%D0%BA%D0%B0_-_high-tech_optical_and_electronic_equipment\">оптических</a> <a href=\"https://www.cnews.ru/book/%D0%A2%D1%80%D0%B0%D0%BD%D1%81%D0%BF%D0%BE%D1%80%D1%82_-_%D0%98%D0%A2%D0%A1_-_%D0%98%D0%BD%D1%82%D0%B5%D0%BB%D0%BB%D0%B5%D0%BA%D1%82%D1%83%D0%B0%D0%BB%D1%8C%D0%BD%D1%8B%D0%B5_%D1%82%D1%80%D0%B0%D0%BD%D1%81%D0%BF%D0%BE%D1%80%D1%82%D0%BD%D1%8B%D0%B5_%D1%81%D0%B8%D1%81%D1%82%D0%B5%D0%BC%D1%8B_-_Intelligent_Transportation_System_-_%D0%95%D0%B4%D0%B8%D0%BD%D0%B0%D1%8F_%D0%BF%D0%BB%D0%B0%D1%82%D1%84%D0%BE%D1%80%D0%BC%D0%B0_%D1%83%D0%BF%D1%80%D0%B0%D0%B2%D0%BB%D0%B5%D0%BD%D0%B8%D1%8F_%D1%82%D1%80%D0%B0%D0%BD%D1%81%D0%BF%D0%BE%D1%80%D1%82%D0%BD%D0%BE%D0%B9_%D1%81%D0%B8%D1%81%D1%82%D0%B5%D0%BC%D1%8B_%D0%95%D0%9F%D0%A3%D0%A2%D0%A1_-_%D0%95%D0%B4%D0%B8%D0%BD%D0%B0%D1%8F_%D1%86%D0%B8%D1%84%D1%80%D0%BE%D0%B2%D0%B0%D1%8F_%D1%82%D1%80%D0%B0%D0%BD%D1%81%D0%BF%D0%BE%D1%80%D1%82%D0%BD%D0%BE-%D0%BB%D0%BE%D0%B3%D0%B8%D1%81%D1%82%D0%B8%D1%87%D0%B5%D1%81%D0%BA%D0%B0%D1%8F_%D1%81%D1%80%D0%B5%D0%B4%D0%B0_%D0%95%D0%A6%D0%A2%D0%9B%D0%A1_-_%D0%A3%D0%BC%D0%BD%D0%B0%D1%8F_%D0%B4%D0%BE%D1%80%D0%BE%D0%B3%D0%B0_-_%D0%A3%D0%BC%D0%BD%D1%8B%D0%B9_%D0%BF%D0%B5%D1%88%D0%B5%D1%85%D0%BE%D0%B4%D0%BD%D1%8B%D0%B9_%D0%BF%D0%B5%D1%80%D0%B5%D1%85%D0%BE%D0%B4\">транспортных систем</a> со спектральным разделением каналов (DWDM/OTN)». Включение в реестр подтверждает соответствие установленным <a href=\"https://www.cnews.ru/book/%D0%9F%D1%80%D0%B0%D0%B2%D0%B8%D1%82%D0%B5%D0%BB%D1%8C%D1%81%D1%82%D0%B2%D0%BE_%D0%A0%D0%A4_-_%D0%9F%D1%80%D0%B0%D0%B2%D0%B8%D1%82%D0%B5%D0%BB%D1%8C%D1%81%D1%82%D0%B2%D0%B0_%D0%A0%D0%BE%D1%81%D1%81%D0%B8%D0%B9%D1%81%D0%BA%D0%BE%D0%B9_%D0%A4%D0%B5%D0%B4%D0%B5%D1%80%D0%B0%D1%86%D0%B8%D0%B8\">Правительством России</a> требованиям к российской промышленной продукции не только в части локализации производства и выполнения технологических операций на территории России, но и в части применения отечественной активной компонентной базы. Об этом CNews сообщили представители «Ростелекома».</p>\n<p>DWDM (Dense Wavelength Division Multiplexing) — комплекс волоконно-оптических систем передачи данных, использующих технологию уплотнения для одновременной передачи множества информационных каналов по паре оптических волокон на разных длинах волн.</p>\n<p>Разработка компании «Булат» учитывает специфику российского рынка магистрального оборудования, ключевое отличие которой — большие расстояния, в том числе, между центрами обработки данных. Иными словами, DWDM-система «Булат» спроектирована таким образом, чтобы обеспечивать максимальную эффективность именно в условиях географии России и существующей кабельной инфраструктуры. </p>\n<p><a href=\"https://www.cnews.ru/book/%D0%9E%D1%81%D0%B5%D0%B5%D0%B2%D1%81%D0%BA%D0%B8%D0%B9_%D0%9C%D0%B8%D1%85%D0%B0%D0%B8%D0%BB\">Михаил Осеевский</a>, президент «Ростелекома»: «DWDM позволяет строить высокопроизводительные опорные сети между городами, дата-центрами и узлами связи. Это \"артерии\" <a href=\"https://www.cnews.ru/book/%D0%A6%D0%B8%D1%84%D1%80%D0%BE%D0%B2%D0%B0%D1%8F_%D1%8D%D0%BA%D0%BE%D0%BD%D0%BE%D0%BC%D0%B8%D0%BA%D0%B0_%D0%A0%D0%BE%D1%81%D1%81%D0%B8%D0%B8_-_%D0%A4%D0%B5%D0%B4%D0%B5%D1%80%D0%B0%D0%BB%D1%8C%D0%BD%D1%8B%D0%B9_%D0%BF%D1%80%D0%BE%D0%B5%D0%BA%D1%82_-_%D0%9D%D0%B0%D1%86%D0%B8%D0%BE%D0%BD%D0%B0%D0%BB%D1%8C%D0%BD%D0%B0%D1%8F_%D0%BF%D1%80%D0%BE%D0%B3%D1%80%D0%B0%D0%BC%D0%BC%D0%B0_%D0%A0%D0%BE%D1%81%D1%81%D0%B8%D0%B9%D1%81%D0%BA%D0%BE%D0%B9_%D0%A4%D0%B5%D0%B4%D0%B5%D1%80%D0%B0%D1%86%D0%B8%D0%B8\">цифровой экономики</a>. Решение о разработке <a href=\"https://www.cnews.ru/book/WDM_-_Wavelength_Division_Multiplexing_-_DWDM_-_Dense_Wavelength_Division_Multiplexing_-_CWDM_-_Coarse_Wavelength_Division_Multiplexing_-_TWDM_-_Time_and_Wavelength_Division_Multiplexed_-_%D0%9F%D0%BB%D0%BE%D1%82%D0%BD%D0%BE%D0%B5_%D0%BC%D1%83%D0%BB%D1%8C%D1%82%D0%B8%D0%BF%D0%BB%D0%B5%D0%BA%D1%81%D0%B8%D1%80%D0%BE%D0%B2%D0%B0%D0%BD%D0%B8%D0%B5_%D1%81_%D1%80%D0%B0%D0%B7%D0%B4%D0%B5%D0%BB%D0%B5%D0%BD%D0%B8%D0%B5%D0%BC_%D0%BF%D0%BE_%D0%B4%D0%BB%D0%B8%D0%BD%D0%B5_%D0%B2%D0%BE%D0%BB%D0%BD%D1%8B\">DWDM-системы</a> было принято задолго до ухода иностранных поставщиков с <a href=\"https://www.cnews.ru/book/%D0%A0%D0%BE%D1%81%D1%81%D0%B8%D1%8F_-_%D0%A0%D0%A4_-_%D0%A0%D0%BE%D1%81%D1%81%D0%B8%D0%B9%D1%81%D0%BA%D0%B0%D1%8F_%D1%84%D0%B5%D0%B4%D0%B5%D1%80%D0%B0%D1%86%D0%B8%D1%8F\">российского рынка</a>, но именно их уход стал <a href=\"https://www.cnews.ru/book/Trigger_-_%D0%A2%D1%80%D0%B8%D0%B3%D0%B3%D0%B5%D1%80_-_%D1%82%D1%80%D0%B8%D0%B3%D0%B3%D0%B5%D1%80%D0%BD%D0%B0%D1%8F_%D1%81%D0%B8%D1%81%D1%82%D0%B5%D0%BC%D0%B0_-_%D0%A2%D1%80%D0%B8%D0%B3%D0%B3%D0%B5%D1%80%D0%BD%D1%8B%D0%B5_%D1%81%D1%86%D0%B5%D0%BD%D0%B0%D1%80%D0%B8%D0%B8\">триггером</a>, который ускорил процесс создания высокопроизводительного оборудования DWDM. С этой задачей мы справились, и текущие тесты это подтверждают».</p>\n<p><b><a href=\"https://www.cnews.ru/book/%D0%9E%D0%BD%D1%8F%D0%BD%D0%BE%D0%B2_%D0%A1%D0%B5%D1%80%D0%B3%D0%B5%D0%B9\">Сергей Онянов</a>,</b> заместитель президента — председателя <a href=\"https://www.cnews.ru/book/%D0%A0%D0%BE%D1%81%D1%82%D0%B5%D0%BB%D0%B5%D0%BA%D0%BE%D0%BC\">правления «Ростелекома»</a>: «С компанией \"Булат\" у нас заключен форвардный контракт на поставку DWDM-систем. Фактически \"Ростелеком\" выступает гарантом стабильного <a href=\"https://www.cnews.ru/book/%D0%9B%D0%BE%D0%B3%D0%B8%D1%81%D1%82%D0%B8%D0%BA%D0%B0_%D1%81%D0%B1%D1%8B%D1%82%D0%BE%D0%B2%D0%B0%D1%8F_-_%D0%A1%D0%B1%D1%8B%D1%82\">сбыта</a>, что позволяет планировать загрузку мощностей предприятия-изготовителя на месяцы или годы вперед, <a href=\"https://www.cnews.ru/book/%D0%98%D0%BD%D0%B2%D0%B5%D1%81%D1%82%D0%B8%D1%86%D0%B8%D0%B8_-_%D0%B8%D0%BD%D0%B2%D0%B5%D1%81%D1%82%D0%B8%D1%80%D0%BE%D0%B2%D0%B0%D0%BD%D0%B8%D0%B5_-_%D0%B8%D0%BD%D0%B2%D0%B5%D1%81%D1%82%D0%B8%D1%86%D0%B8%D0%BE%D0%BD%D0%BD%D1%8B%D0%B5_%D0%BF%D1%80%D0%BE%D0%B5%D0%BA%D1%82%D1%8B_-_%D0%B8%D0%BD%D0%B2%D0%B5%D1%81%D1%82%D0%B8%D1%86%D0%B8%D0%BE%D0%BD%D0%BD%D0%BE%D0%B5_%D0%BA%D0%BE%D0%BD%D1%81%D1%83%D0%BB%D1%8C%D1%82%D0%B8%D1%80%D0%BE%D0%B2%D0%B0%D0%BD%D0%B8%D0%B5\">инвестировать</a> в расширение производственных линий, не рискуя остаться без заказов. Для нас это возможность получить оборудование с фиксированной ценой и сроками поставки. То, что уже сейчас мы можем устанавливать DWDM-системы собственного производства на нашу сетевую инфраструктуру и предлагать это оборудование другим операторам связи — лучшее доказательство эффективности выбранной модели взаимодействия. Сам факт производства такого оборудования в России — это важный шаг к <a href=\"https://www.cnews.ru/book/%D0%98%D0%BC%D0%BF%D0%BE%D1%80%D1%82%D0%BE%D0%B7%D0%B0%D0%BC%D0%B5%D1%89%D0%B5%D0%BD%D0%B8%D0%B5_-_%D0%98%D0%BC%D0%BF%D0%BE%D1%80%D1%82%D0%BE%D0%BD%D0%B5%D0%B7%D0%B0%D0%B2%D0%B8%D1%81%D0%B8%D0%BC%D0%BE%D1%81%D1%82%D1%8C_-_%D1%82%D0%B5%D1%85%D0%BD%D0%BE%D0%BB%D0%BE%D0%B3%D0%B8%D1%87%D0%B5%D1%81%D0%BA%D0%B8%D0%B9_%D1%86%D0%B8%D1%84%D1%80%D0%BE%D0%B2%D0%BE%D0%B9_%D1%81%D1%83%D0%B2%D0%B5%D1%80%D0%B5%D0%BD%D0%B8%D1%82%D0%B5%D1%82_-_%D1%80%D0%B5%D0%B6%D0%B8%D0%BC_%D0%BF%D1%80%D0%B8%D0%BE%D1%80%D0%B8%D1%82%D0%B5%D1%82%D0%BD%D1%8B%D1%85_%D0%B7%D0%B0%D0%BA%D1%83%D0%BF%D0%BE%D0%BA_%D0%BE%D1%82%D0%B5%D1%87%D0%B5%D1%81%D1%82%D0%B2%D0%B5%D0%BD%D0%BD%D1%8B%D1%85_%D1%80%D0%B5%D1%88%D0%B5%D0%BD%D0%B8%D0%B9_%D0%B8_%D1%82%D0%B5%D1%85%D0%BD%D0%BE%D0%BB%D0%BE%D0%B3%D0%B8%D0%B9\">технологическому суверенитету</a> страны».</p>\n<p><b><a href=\"https://www.cnews.ru/book/%D0%9F%D1%80%D0%B8%D1%89%D0%B5%D0%BC%D0%B8%D1%85%D0%B8%D0%BD_%D0%90%D0%BD%D0%B4%D1%80%D0%B5%D0%B9\">Андрей Прищемихин</a>,</b> директор <a href=\"https://www.cnews.ru/book/%D0%A0%D0%BE%D1%81%D1%81%D0%B8%D1%8F_-_%D0%AE%D0%A4%D0%9E_-_%D0%A0%D0%BE%D1%81%D1%82%D0%BE%D0%B2%D1%81%D0%BA%D0%B0%D1%8F_%D0%BE%D0%B1%D0%BB%D0%B0%D1%81%D1%82%D1%8C\">Ростовского</a> опорного филиала «Ростелекома» в <a href=\"https://www.cnews.ru/book/%D0%A0%D0%BE%D1%81%D1%81%D0%B8%D1%8F_-_%D0%AE%D0%A4%D0%9E_-_%D0%AE%D0%B6%D0%BD%D1%8B%D0%B9_%D1%84%D0%B5%D0%B4%D0%B5%D1%80%D0%B0%D0%BB%D1%8C%D0%BD%D1%8B%D0%B9_%D0%BE%D0%BA%D1%80%D1%83%D0%B3\">ЮФО</a> и <a href=\"https://www.cnews.ru/book/%D0%A0%D0%BE%D1%81%D1%81%D0%B8%D1%8F_-_%D0%A1%D0%9A%D0%A4%D0%9E_-_%D0%A1%D0%B5%D0%B2%D0%B5%D1%80%D0%BE-%D0%9A%D0%B0%D0%B2%D0%BA%D0%B0%D0%B7%D1%81%D0%BA%D0%B8%D0%B9_%D1%84%D0%B5%D0%B4%D0%B5%D1%80%D0%B0%D0%BB%D1%8C%D0%BD%D1%8B%D0%B9_%D0%BE%D0%BA%D1%80%D1%83%D0%B3\">СКФО</a>: «<a href=\"https://www.cnews.ru/book/%D0%9E%D0%BF%D1%82%D0%B8%D1%87%D0%B5%D1%81%D0%BA%D0%B8%D0%B5_%D1%82%D0%B5%D1%85%D0%BD%D0%BE%D0%BB%D0%BE%D0%B3%D0%B8%D0%B8_-_Optical_technologies_-_%D0%B2%D1%8B%D1%81%D0%BE%D0%BA%D0%BE%D1%82%D0%B5%D1%85%D0%BD%D0%BE%D0%BB%D0%BE%D0%B3%D0%B8%D1%87%D0%BD%D0%B0%D1%8F_%D0%BE%D0%BF%D1%82%D0%B8%D0%BA%D0%BE-%D1%8D%D0%BB%D0%B5%D0%BA%D1%82%D1%80%D0%BE%D0%BD%D0%BD%D0%B0%D1%8F_%D1%82%D0%B5%D1%85%D0%BD%D0%B8%D0%BA%D0%B0_-_high-tech_optical_and_electronic_equipment\">Оптическая инфраструктура</a> — это фундамент <a href=\"https://www.cnews.ru/book/%D0%A6%D0%B8%D1%84%D1%80%D0%BE%D0%B2%D0%B0%D1%8F_%D1%82%D1%80%D0%B0%D0%BD%D1%81%D1%84%D0%BE%D1%80%D0%BC%D0%B0%D1%86%D0%B8%D1%8F_-_Digital_Transformation_-_Digital_IQ_-_%D0%A6%D0%B8%D1%84%D1%80%D0%BE%D0%B2%D0%B8%D0%B7%D0%B0%D1%86%D0%B8%D1%8F_-_%D0%A6%D0%B8%D1%84%D1%80%D0%BE%D0%B2%D0%BE%D0%B5_%D0%BF%D1%80%D0%B5%D0%B4%D0%BF%D1%80%D0%B8%D1%8F%D1%82%D0%B8%D0%B5_-_%D0%94%D0%B8%D0%B4%D0%B6%D0%B8%D1%82%D0%B0%D0%BB%D0%B8%D0%B7%D0%B0%D1%86%D0%B8%D1%8F_-_%D0%A6%D0%B8%D1%84%D1%80%D0%BE%D0%B2%D1%8B%D0%B5_%D1%82%D0%B5%D1%85%D0%BD%D0%BE%D0%BB%D0%BE%D0%B3%D0%B8%D0%B8_%D0%B2_%D0%B1%D0%B8%D0%B7%D0%BD%D0%B5%D1%81%D0%B5_-_%D0%A6%D0%B8%D1%84%D1%80%D0%BE%D0%B2%D0%BE%D0%B5_%D0%BF%D1%80%D0%BE%D1%81%D1%82%D1%80%D0%B0%D0%BD%D1%81%D1%82%D0%B2%D0%BE_-_%D0%A6%D0%B8%D1%84%D1%80%D0%BE%D0%B2%D0%B0%D1%8F_%D0%B7%D1%80%D0%B5%D0%BB%D0%BE%D1%81%D1%82%D1%8C\">цифровизации</a> всей страны, и для “Ростелекома” это направление остается абсолютным приоритетом. Юг России с его активным развитием бизнеса и территорий и связанным с этим ростом потребления цифровых сервисов требует колоссальных сетевых мощностей. Новая DWDM-система “Булат” значительно упрощает этот процесс: благодаря высокой плотности компоновки и <a href=\"https://www.cnews.ru/book/Smart_%D1%82%D0%B5%D1%85%D0%BD%D0%BE%D0%BB%D0%BE%D0%B3%D0%B8%D0%B8_-_%D0%A1%D0%BC%D0%B0%D1%80%D1%82%D0%B8%D0%B7%D0%B0%D1%86%D0%B8%D1%8F_-_%D0%98%D0%BD%D1%82%D0%B5%D0%BB%D0%BB%D0%B5%D0%BA%D1%82%D1%83%D0%B0%D0%BB%D0%B8%D0%B7%D0%B0%D1%86%D0%B8%D1%8F_-_%D0%98%D0%BD%D1%82%D0%B5%D0%BB%D0%BB%D0%B5%D0%BA%D1%82%D1%83%D0%B0%D0%BB%D1%8C%D0%BD%D1%8B%D0%B5_%D1%82%D0%B5%D1%85%D0%BD%D0%BE%D0%BB%D0%BE%D0%B3%D0%B8%D0%B8\">интеллектуальным</a> архитектурным решениям, мы кратно увеличим пропускную способность существующих линий, не прибегая к масштабным и затратным работам по прокладке кабеля. Это не просто технологическое обновление, а инструмент, который позволяет нам строить более гибкие, устойчивые и эффективные сети, оперативно реагируя на запросы бизнеса, государства и жителей наших регионов».</p>\n<p>Сейчас оборудование находится в стадии опытной эксплуатации: тесты проводятся как в лабораториях, так и на действующих сетях операторов. Производство развернуто на двух площадках — основное на заводе «РТТ» «Ростелекома» <a href=\"https://www.cnews.ru/book/%D0%A0%D0%BE%D1%81%D1%81%D0%B8%D1%8F_-_%D0%A1%D0%97%D0%A4%D0%9E_-_%D0%A1%D0%B0%D0%BD%D0%BA%D1%82-%D0%9F%D0%B5%D1%82%D0%B5%D1%80%D0%B1%D1%83%D1%80%D0%B3_-_%D0%A1%D0%B0%D0%BD%D0%BA%D1%82-%D0%9F%D0%B5%D1%82%D0%B5%D1%80%D0%B1%D1%83%D1%80%D0%B3%D1%81%D0%BA%D0%B0%D1%8F_%D0%B3%D0%BE%D1%80%D0%BE%D0%B4%D1%81%D0%BA%D0%B0%D1%8F_%D0%B0%D0%B3%D0%BB%D0%BE%D0%BC%D0%B5%D1%80%D0%B0%D1%86%D0%B8%D1%8F\">в Санкт-Петербурге</a> и дополнительное — на мощностях компании-партнера. </p>\n<p>Для DWDM «Булат» впервые <a href=\"https://www.cnews.ru/book/%D0%A0%D0%BE%D1%81%D1%81%D0%B8%D1%8F_-_%D0%A0%D0%A4_-_%D0%A0%D0%BE%D1%81%D1%81%D0%B8%D0%B9%D1%81%D0%BA%D0%B0%D1%8F_%D1%84%D0%B5%D0%B4%D0%B5%D1%80%D0%B0%D1%86%D0%B8%D1%8F\">в России</a> произведен один из технологически наиболее сложных элементов аппаратной платформы — 16-слойная <a href=\"https://www.cnews.ru/book/%D0%AD%D0%BB%D0%B5%D0%BA%D1%82%D1%80%D0%BE%D0%BD%D0%B8%D0%BA%D0%B0_-_%D0%9F%D0%B5%D1%87%D0%B0%D1%82%D0%BD%D0%B0%D1%8F_%D0%BF%D0%BB%D0%B0%D1%82%D0%B0_-_printed_circuit_board_PCB_-_printed_wiring_board_PWB\">печатная плата</a> шестого класса точности, что позволило не только повысить плотность компоновки элементов, но и обеспечить необходимые характеристики целостности сигнала, электромагнитной совместимости и отвода тепла. Создание такой платы демонстрирует то, что российская электронная промышленность освоила выпуск компонентов высочайшей сложности, которые раньше были доступны только зарубежным производителям.</p>\n\n    <a href=\"https://www.cnconf.ru/events/lcnc_revolyuciya_novaya_arhitektura_cifrovoi_nezavisimosti.shtml\">\n        <img src=\"https://static.cnews.ru/img/cnews/2026/05/26/low-code.webp\" alt=\"Low/no-code-революция: новая архитектура цифровой независимости\">\n        <p>Low/no-code-революция: новая архитектура цифровой независимости\n            Конференция\n        </p>\n    </a>\n<p><b>Сергей Болонистов, </b><a href=\"https://www.cnews.ru/book/CTO_-_Chief_Technology_Officer_-_%D0%A2%D0%B5%D1%85%D0%BD%D0%B8%D1%87%D0%B5%D1%81%D0%BA%D0%B8%D0%B9_%D0%B4%D0%B8%D1%80%D0%B5%D0%BA%D1%82%D0%BE%D1%80\">технический директор</a> компании «Булат»: «Мы намеренно сделали систему открытой. Она совместима с оборудованием любых других поставщиков — как на аппаратном, так и на программном уровне. Никаких \"привязок\" к одному производителю для заказчика не возникает. Интеграция возможна в уже построенные сети, при этом у нас нет ограничений по производственным мощностям: мы способны оперативно наращивать выпуск под реальные запросы рынка. Чем больше игроков будет предлагать совместимые решения, тем здоровее будет конкуренция, выше качество и доступность технологии для операторов».</p>\n<p>Технология DWDM позволяет передавать десятки оптических каналов через одну пару оптических волокон, что дает возможность наращивать пропускную способность сети используя существующую кабельную инфраструктуру без прокладки дополнительных линий связи.</p>\n<p>Система DWDM разработки компании «Булат» представляет собой связку программного обеспечения и оборудования DWDM — модульной платформы, состоящей из шасси (корпуса) и набора сменных карт. Особенность платформы заключается в возможности разделения слотов на полуслоты для увеличения плотности портов, наличии кросс-коммутации по backplane (объединительной карте), и полностью универсальных карт. </p>\n<p>Благодаря применению системы DWDM для значительного увеличения пропускной способности оператору достаточно установить на существующей <a href=\"https://www.cnews.ru/book/%D0%9E%D0%BF%D0%B5%D1%80%D0%B0%D1%82%D0%BE%D1%80_%D1%81%D0%B2%D1%8F%D0%B7%D0%B8_-_%D0%A2%D0%B5%D0%BB%D0%B5%D0%BA%D0%BE%D0%BC%D0%BC%D1%83%D0%BD%D0%B8%D0%BA%D0%B0%D1%86%D0%B8%D0%BE%D0%BD%D0%BD%D1%8B%D0%B9_%D0%BE%D0%BF%D0%B5%D1%80%D0%B0%D1%82%D0%BE%D1%80_-_%D0%A3%D1%81%D0%BB%D1%83%D0%B3%D0%B8_%D1%81%D0%B2%D1%8F%D0%B7%D0%B8_-_%D0%A3%D1%81%D0%BB%D1%83%D0%B3%D0%B8_%D0%BC%D0%B5%D0%B6%D0%B4%D1%83%D0%B3%D0%BE%D1%80%D0%BE%D0%B4%D0%BD%D0%BE%D0%B9_%D0%B8_%D0%BC%D0%B5%D0%B6%D0%B4%D1%83%D0%BD%D0%B0%D1%80%D0%BE%D0%B4%D0%BD%D0%BE%D0%B9_%D1%81%D0%B2%D1%8F%D0%B7%D0%B8_-_Telecom_operator_-_Communication_services_-_Intercity_and_international_communication_services\">линии связи</a> новый <a href=\"https://www.cnews.ru/book/%D0%A2%D1%80%D0%B0%D0%BD%D1%81%D0%BF%D0%BE%D0%BD%D0%B4%D0%B5%D1%80_-_Transponder_-_Transmitter-responder_-_%D0%BF%D0%B5%D1%80%D0%B5%D0%B4%D0%B0%D1%82%D1%87%D0%B8%D0%BA-%D0%BE%D1%82%D0%B2%D0%B5%D1%82%D1%87%D0%B8%D0%BA_-_%D1%80%D0%B0%D0%B4%D0%B8%D0%BE%D0%BE%D1%82%D0%B2%D0%B5%D1%82%D1%87%D0%B8%D0%BA\">передатчик</a> и настроить его на новую длину волны. Система заменяет десятки отдельных пар оптических волокон, существенно снижая капитальные и операционные затраты операторов.</p>\n<p>***</p>\n<p>Технические характеристики: Оборудование поддерживает скорость передачи до 200 Гбит/с и до 96 оптических каналов. В состав шасси входят стандартные усилители EDFA, рамановские усилители, перестраиваемые и фиксированные мультиплексоры/демультиплексоры и карты формирования сигнала. Линейные скорости варьируются от 10 до 200 <a href=\"https://www.cnews.ru/book/ISP_-_Internet_Service_Provider_-_Internet_Access_Provider_-_%D0%98%D0%BD%D1%82%D0%B5%D1%80%D0%BD%D0%B5%D1%82-%D0%BF%D1%80%D0%BE%D0%B2%D0%B0%D0%B9%D0%B4%D0%B5%D1%80\">Гбит/с</a>. В настоящее время ведется разработка карт нового поколения с линейными скоростями до 400–800 Гбит/с — выход опытных образцов запланирован на 2027 г.</p>\n        \n    \n    \n        \n        \n    \n    \n    \n\n    \n        \n    \n    \n    \n            <ul>\n<li><a href=\"https://www.cnews.ru/event/osennij_dokumentooborot-2026_praktikum\">Заголовок строки - «Осенний документооборот-2026»: практикум для тех, кто управляет документами и процессами</a></li>\n</ul>\n\n    \n        \n    \n    \n\n    \n    \n\n\n\n\n\n    \n    \n\n\n    \n\n\t\t<p>\n\t\t\t</p><h2>Другие материалы рубрики</h2>\n\t\t<p></p>\n\t\t\n\t\n\n<!-- конференции -->\n    \n\n<!-- /конференции -->\n\n\n\n\n\n\n\n","contentTruncated":false}
